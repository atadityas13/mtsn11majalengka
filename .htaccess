<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Jangan rewrite file/folder yang memang ada di root (mis. .well-known)
    RewriteRule ^(public)($|/) - [L]

    # Semua request masuk ke Laravel public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Options -Indexes
</IfModule>
